# Copy to .env and fill in:  cp .env.example .env
# Agents cannot read .env (blocked in .claude/settings.json). Never commit .env.
# Everything below is optional: without it, the office works with local files only.

# --- Atlassian login (used by both Jira and Confluence sync) ---
# Site: your Atlassian Cloud URL, e.g. https://your-team.atlassian.net
# Email: the email you sign in to Atlassian with
# API token: https://id.atlassian.com/manage-profile/security/api-tokens -> Create API token
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Jira ---
# Key of the Jira project that receives the office's tickets (e.g. AGENTIC).
# Create it first in Jira (Kanban is simplest). See docs/integrations.md.
JIRA_PROJECT_KEY=

# --- Confluence ---
# Key of the space to publish docs into. The sync creates it if it does not exist.
# Requires Confluence on your Atlassian site (the Free plan works).
CONFLUENCE_SPACE_KEY=
CONFLUENCE_SPACE_NAME=Agentic Office

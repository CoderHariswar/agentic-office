# Copy to .env and fill in. Agents cannot read .env (blocked in .claude/settings.json).

# --- Jira Cloud ---
# API token: https://id.atlassian.com/manage-profile/security/api-tokens -> Create API token
# Email: the email you sign in to Atlassian with
# Project key: create a Scrum or Kanban project in Jira (e.g. key OFFICE) and put its key here
JIRA_SITE=https://jhaankitkumar12.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Trello (optional) ---
# API key: https://trello.com/power-ups/admin -> create a Power-Up -> API key
# Token: open https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=YOUR_API_KEY
# Board ID: open your board, add .json to its URL, copy "id" (or use the short id from the URL)
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
